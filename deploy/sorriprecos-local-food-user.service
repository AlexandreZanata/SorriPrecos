[Unit]
Description=SorriPrecos - catalogos publicos do comercio local de Sorriso
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/PESSOAL-PROJETOS-ALEXANDRE/SorriPrecos
Environment=DATABASE_URL=sqlite://data/sorriprecos.db
ExecStart=/usr/bin/flock -n /tmp/sorriprecos-local-food.lock %h/PESSOAL-PROJETOS-ALEXANDRE/SorriPrecos/target/release/sorriprecos collect-local-food --config config/aiqfome.json --watch
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
MemoryMax=768M

[Install]
WantedBy=default.target
