[Unit]
Description=SorriPrecos API (repositorio local)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/PESSOAL-PROJETOS-ALEXANDRE/SorriPrecos
Environment=DATABASE_URL=sqlite://data/sorriprecos.db
Environment=BIND=127.0.0.1:8080
Environment=RUST_LOG=sorriprecos=info,tower_http=warn
ExecStart=%h/PESSOAL-PROJETOS-ALEXANDRE/SorriPrecos/target/release/sorriprecos serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
MemoryMax=512M

[Install]
WantedBy=default.target
