[Unit]
Description=SorriPrecos public VTEX pharmacy catalogues (Sorriso-MT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sorriprecos
Group=sorriprecos
WorkingDirectory=/opt/sorriprecos
Environment=DATABASE_URL=sqlite:///var/lib/sorriprecos/catalog.db
Environment=RUST_LOG=sorriprecos=info
ExecStart=/usr/bin/flock -n /var/lib/sorriprecos/pharmacy.lock /opt/sorriprecos/sorriprecos collect-pharmacy-vtex --watch
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sorriprecos
MemoryMax=384M

[Install]
WantedBy=multi-user.target
